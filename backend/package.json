{
  "name": "@bonoful/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/main.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "test": "node --test tests/unit.test.cjs",
    "test:integration": "node --test --test-concurrency=1 tests/integration.test.cjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/swagger": "^11.2.0",
    "@prisma/client": "6.19.2",
    "argon2": "^0.44.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.0",
    "helmet": "^8.1.0",
    "nodemailer": "^10.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.2",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.19.0",
    "@types/nodemailer": "^7.0.0",
    "prisma": "6.19.2",
    "tsx": "^4.20.0",
    "typescript": "5.9.3",
    "vitest": "^5.0.0"
  },
  "overrides": { "effect": "^3.20.0", "deepmerge-ts": "^8.0.0", "multer": "^2.3.0" },
  "prisma": { "seed": "tsx prisma/seed.ts" }
}
