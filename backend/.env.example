NODE_ENV=development
HOST=127.0.0.1
PORT=4000
DATABASE_URL=postgresql://bonoful:CHANGE_ME@127.0.0.1:5432/bonoful
WEB_ORIGIN=http://localhost:3000
# Generate 32 random bytes as 64 hexadecimal characters. Never reuse a sample key.
DATA_KEY=REPLACE_WITH_64_HEX_CHARACTERS
FILE_ROOT=./storage
SMTP_URL=
MAIL_FROM=care@example.com
# Optional phone OTP provider. The endpoint receives JSON: {"to":"+880...","message":"..."}.
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
TAX_BPS=0
SHIPPING_FEE=12000
FREE_SHIPPING_MINIMUM=800000
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
SEED_STAFF_EMAIL=staff@example.com
SEED_STAFF_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
SEED_CUSTOMER_EMAIL=customer@example.com
SEED_CUSTOMER_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
